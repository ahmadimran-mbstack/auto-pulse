# Neon Auth URL (used by the frontend and backend to verify tokens)
NEON_AUTH_BASE_URL=https://auth.example.neon.tech/neondb/auth

# Neon pooled database connection string (used by the backend application)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct database connection string (used only by Alembic for migrations)
DATABASE_URL_DIRECT=postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require

# Allowed origins for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# Environment mode: development or production
ENV=development

# Logging level (optional, defaults to INFO)
LOG_LEVEL=INFO

# LinkedIn OAuth 2.0 configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/app/connections/linkedin/callback

# Symmetric encryption key for tokens (Fernet key: 32 url-safe base64-encoded bytes)
# Generate in python with: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
TOKEN_ENCRYPTION_KEY=replace_with_fernet_encryption_key

# Search provider: tavily or exa
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key
EXA_API_KEY=your_exa_api_key

# LLM configuration (Google Gemini, OpenAI, Anthropic, etc.)
# LLM_PROVIDER=google_genai
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_FAST=gemini-2.5-flash

# Pipeline schedule and feature flags
DRAFT_LEAD_MINUTES=180
SEARCH_LOOKBACK_DAYS=3
GENERATION_ENABLED=true

# Email and approval settings
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=AutoPulse <noreply@autopulse.app>
APP_BASE_URL=http://localhost:3000

# SMTP server configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# LinkedIn publishing configuration
LINKEDIN_API_VERSION=202601
LINKEDIN_VISIBILITY=CONNECTIONS
PUBLISH_ENABLED=true

# Redis and caching configuration
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
CACHE_READS_ENABLED=false
TRUSTED_PROXY_COUNT=0
