# Neon Auth URL (used by the frontend and backend to verify tokens)
NEON_AUTH_BASE_URL=https://auth.example.neon.tech/neondb/auth

# Neon pooled database connection string (used by the backend application)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct database connection string (used only by Alembic for migrations)
DATABASE_URL_DIRECT=postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require

# Allowed origins for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# Environment mode: development or production
ENV=development

# Logging level (optional, defaults to INFO)
LOG_LEVEL=INFO
